{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Commande - Paiement - InnovShop{% endblock %}

{% block body %}
    <h1 class="mb-4">Passer la commande</h1>
    {% include 'checkout/_steps.html.twig' with {etape: 3} %}

    <h2 class="h5 mb-3">Paiement par carte bancaire</h2>

    <div class="alert alert-info">
        Site de démonstration : aucun paiement réel n'est effectué et les données de carte ne sont pas conservées.
        Utilisez un numéro de test, par exemple <strong>4242 4242 4242 4242</strong>, une date d'expiration future et un cryptogramme à 3 chiffres.
    </div>

    <div class="row">
        <div class="col-12 col-md-8 col-lg-6">
            <p class="fw-semibold">Montant à régler : {{ total|number_format(2, ',', ' ') }} €</p>

            {{ form_start(form, {attr: {autocomplete: 'off'}}) }}
                {{ form_row(form.titulaire) }}
                {{ form_row(form.numero) }}
                <div class="row">
                    <div class="col-7">{{ form_row(form.expiration) }}</div>
                    <div class="col-5">{{ form_row(form.cryptogramme) }}</div>
                </div>

                <div class="d-flex justify-content-between mt-3">
                    <a href="{{ path('app_checkout_livraison') }}" class="btn btn-outline-secondary">Retour</a>
                    <button type="submit" class="btn btn-dark">Continuer vers la confirmation</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

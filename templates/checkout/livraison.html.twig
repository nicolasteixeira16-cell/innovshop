{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Commande - Livraison - InnovShop{% endblock %}

{% block body %}
    <h1 class="mb-4">Passer la commande</h1>
    {% include 'checkout/_steps.html.twig' with {etape: 2} %}

    <h2 class="h5 mb-3">Adresse de livraison</h2>

    <div class="row">
        <div class="col-12 col-md-8 col-lg-6">
            {{ form_start(form) }}
                {{ form_row(form.rue) }}
                <div class="row">
                    <div class="col-5">{{ form_row(form.codePostal) }}</div>
                    <div class="col-7">{{ form_row(form.ville) }}</div>
                </div>
                {{ form_row(form.pays) }}

                <div class="d-flex justify-content-between mt-3">
                    <a href="{{ path('app_checkout_recap') }}" class="btn btn-outline-secondary">Retour</a>
                    <button type="submit" class="btn btn-dark">Continuer vers la confirmation</button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
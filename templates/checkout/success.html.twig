{% extends 'base.html.twig' %}

{% block title %}Commande enregistrée - InnovShop{% endblock %}

{% block body %}
    <div class="text-center py-5">
        <h1 class="mb-3">Merci pour votre commande !</h1>
        <p class="fs-5">Votre commande <strong>n° {{ commande.id }}</strong> a bien été enregistrée.</p>
        <p>Montant total : <strong>{{ commande.total|number_format(2, ',', ' ') }} €</strong></p>

        <address class="d-inline-block text-start bg-white border rounded p-3 my-3">
            {{ commande.adresseLivraison|nl2br }}
        </address>

        <div>
            <a href="{{ path('app_produit_index') }}" class="btn btn-dark">Continuer mes achats</a>
        </div>
    </div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Commande n° {{ commande.id }} - InnovShop{% endblock %}

{% block body %}
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_account') }}">Mon compte</a></li>
            <li class="breadcrumb-item"><a href="{{ path('app_account_orders') }}">Mes commandes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Commande n° {{ commande.id }}</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Commande n° {{ commande.id }}</h1>
        <span class="fs-5">{% include 'account/_statut.html.twig' %}</span>
    </div>
    <p class="text-muted">Passée le {{ commande.dateCreation|date('d/m/Y à H:i') }}</p>

    {# Indicateur visuel du suivi #}
    {% if commande.statut == 'annulee' %}
        <div class="alert alert-danger">Cette commande a été annulée.</div>
    {% else %}
        {% set rang = {en_attente: 1, validee: 2, expediee: 3} %}
        {% set etapes = {en_attente: 'En attente', validee: 'Validée', expediee: 'Expédiée'} %}
        <ol class="list-unstyled d-flex gap-2 mb-4">
            {% for code, libelle in etapes %}
                <li class="flex-fill text-center p-2 rounded
                    {{ rang[code] <= rang[commande.statut] ? 'bg-success text-white' : 'bg-white border text-muted' }}">
                    {{ libelle }}
                </li>
            {% endfor %}
        </ol>
    {% endif %}

    <div class="table-responsive">
        <table class="table align-middle bg-white">
            <thead>
                <tr>
                    <th>Produit</th>
                    <th class="text-end">Prix unitaire</th>
                    <th class="text-center">Qté</th>
                    <th class="text-end">Sous-total</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in commande.ligneCommandes %}
                    <tr>
                        <td>{{ ligne.nomProduit }}</td>
                        <td class="text-end">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €</td>
                        <td class="text-center">{{ ligne.quantite }}</td>
                        <td class="text-end">{{ ligne.sousTotal|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">{{ commande.total|number_format(2, ',', ' ') }} €</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <h2 class="h5">Adresse de livraison</h2>
    <address class="bg-white border rounded p-3 mb-4">{{ commande.adresseLivraison|nl2br }}</address>

    <div class="d-flex flex-wrap gap-2">
    <a href="{{ path('app_account_orders') }}" class="btn btn-outline-secondary">Retour à mes commandes</a>
    {% if commande.statut != 'annulee' %}
        <a href="{{ path('app_account_order_invoice', {id: commande.id}) }}" class="btn btn-dark">Télécharger la facture (PDF)</a>
    {% endif %}
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}{{ creation ? 'Ajouter un produit' : 'Modifier le produit' }} - InnovShop{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="h2 mb-3">{{ creation ? 'Ajouter un produit' : 'Modifier le produit' }}</h1>

            <div class="alert alert-info">
                Votre produit sera visible dans le catalogue après validation par un administrateur.
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom) }}
                            <div class="text-danger small">{{ form_errors(form.nom) }}</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.categorie) }}
                            {{ form_widget(form.categorie) }}
                            <div class="text-danger small">{{ form_errors(form.categorie) }}</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description) }}
                            <div class="text-danger small">{{ form_errors(form.description) }}</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.prix) }}
                            {{ form_widget(form.prix) }}
                            <div class="text-danger small">{{ form_errors(form.prix) }}</div>
                        </div>
                        <div class="mb-3">
                            {% if produit.image %}
                                <div class="mb-2">
                                    <img src="{{ asset('uploads/produits/' ~ produit.image) }}" alt="Image actuelle" height="80" class="rounded">
                                </div>
                            {% endif %}
                            {{ form_label(form.imageFichier) }}
                            {{ form_widget(form.imageFichier) }}
                            <div class="text-danger small">{{ form_errors(form.imageFichier) }}</div>
                        </div>
                        <div class="d-flex gap-2">
                            {{ form_widget(form.enregistrer) }}
                            <a href="{{ path('app_vendeur_produit_index') }}" class="btn btn-outline-secondary">Annuler</a>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Tableau de bord{% endblock %}

{% block main %}
    <div class="row g-3">
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted">Produits</div>
                    <div class="fs-2 fw-bold">{{ nbProduits }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted">Commandes</div>
                    <div class="fs-2 fw-bold">{{ nbCommandes }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted">Commandes en attente</div>
                    <div class="fs-2 fw-bold">{{ nbCommandesEnAttente }}</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card">
                <div class="card-body">
                    <div class="text-muted">Utilisateurs</div>
                    <div class="fs-2 fw-bold">{{ nbUtilisateurs }}</div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
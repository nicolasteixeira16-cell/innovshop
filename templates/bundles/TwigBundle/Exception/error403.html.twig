{% extends 'base.html.twig' %}

{% block title %}Accès refusé - InnovShop{% endblock %}

{% block body %}
    <div class="text-center py-5">
        <p class="display-1 fw-bold text-muted">403</p>
        <h1 class="h3 mb-3">Accès refusé</h1>
        <p class="text-muted mb-4">Vous n'avez pas les droits nécessaires pour consulter cette page.</p>
        <a href="{{ path('app_home') }}" class="btn btn-dark me-2">Retour à l'accueil</a>
        {% if not app.user %}
            <a href="{{ path('app_login') }}" class="btn btn-outline-dark">Se connecter</a>
        {% endif %}
    </div>
{% endblock %}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Erreur - InnovShop</title>
    <style>
        body { font-family: Arial, Helvetica, sans-serif; background: #f8f9fa; color: #212529; text-align: center; padding: 80px 16px; }
        .code { font-size: 72px; font-weight: bold; color: #6c757d; margin: 0; }
        a { display: inline-block; margin-top: 24px; background: #212529; color: #fff; text-decoration: none; padding: 10px 18px; border-radius: 4px; }

<div class="col">
    <div class="card card-produit h-100 shadow-sm">
        {% if produit.image %}
            <img src="{{ asset('uploads/produits/' ~ produit.image) }}"
                 class="card-img-top" alt="{{ produit.nom }}"
                 style="height: 200px; object-fit: cover;">
        {% else %}
            <div class="bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center"
                 style="height: 200px;">Pas d'image</div>
        {% endif %}
        <div class="card-body d-flex flex-column">
            <div class="mb-2">
                <span class="badge text-bg-light">{{ produit.categorie.nom }}</span>
                {% if produit.categorie.slug == 'prototypes' %}<span class="badge badge-prototype">Prototype</span>{% endif %}
            </div>
            <h5 class="card-title">{{ produit.nom }}</h5>
            <p class="card-text text-muted small">
                {% set texte = produit.description|striptags %}
                {{ texte|length > 90 ? texte|slice(0, 90) ~ '…' : texte }}
            </p>
            <div class="mt-auto">
                <strong class="prix d-block mb-2">{{ produit.prix|number_format(2, ',', ' ') }} €</strong>
                <div class="d-flex gap-2">
                    <a href="{{ path('app_produit_show', {id: produit.id}) }}" class="btn btn-sm btn-outline-primary flex-fill">Voir</a>
                    <form data-cart-form data-turbo="false" method="post" action="{{ path('app_cart_add', {id: produit.id}) }}" class="flex-fill d-grid">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart') }}">
                        <button class="btn btn-sm btn-primary">Ajouter</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
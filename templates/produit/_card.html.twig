<div class="col">
    <div class="card h-100 shadow-sm">
        {% if produit.image %}
            <img src="{{ asset('uploads/produits/' ~ produit.image) }}"
                 class="card-img-top" alt="{{ produit.nom }}"
                 style="height: 200px; object-fit: cover;">
        {% else %}
            <div class="bg-secondary-subtle text-secondary d-flex align-items-center justify-content-center"
                 style="height: 200px;">Pas d'image</div>
        {% endif %}
        <div class="card-body d-flex flex-column">
            <span class="badge text-bg-light align-self-start mb-2">{{ produit.categorie.nom }}</span>
            <h5 class="card-title">{{ produit.nom }}</h5>
            <p class="card-text text-muted small">
                {% set texte = produit.description|striptags %}
                {{ texte|length > 90 ? texte|slice(0, 90) ~ '…' : texte }}
            </p>
            <div class="mt-auto d-flex justify-content-between align-items-center">
                <strong>{{ produit.prix|number_format(2, ',', ' ') }} €</strong>
                <a href="{{ path('app_produit_show', {id: produit.id}) }}" class="btn btn-sm btn-dark">Voir le produit</a>
            </div>
        </div>
    </div>
</div>
{% extends 'base.html.twig' %}

{% block title %}Devenez testeurs - InnovShop{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h1 class="h2 mb-3">Devenez testeurs d'InnovShop</h1>
            <p class="text-muted">
                Vous voulez essayer InnovShop en avant-première et nous aider à l'améliorer ?
                Présentez-vous en quelques lignes : nous reviendrons vers vous.
            </p>

            <div class="card shadow-sm">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom) }}
                            <div class="text-danger small">{{ form_errors(form.nom) }}</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email) }}
                            <div class="text-danger small">{{ form_errors(form.email) }}</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.motivation) }}
                            {{ form_widget(form.motivation) }}
                            <div class="text-danger small">{{ form_errors(form.motivation) }}</div>
                        </div>
                        {{ form_widget(form.envoyer) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Devenez testeurs de prototypes - InnovShop{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <h1 class="h2 mb-3">Devenez testeurs de prototypes</h1>
            <p class="text-muted">
                InnovShop présente en avant-première des produits encore en phase de prototype.
                Rejoignez notre communauté de testeurs : vous essayez ces produits avant leur
                commercialisation et vos retours contribuent à les améliorer.
                Dites-nous ce qui vous intéresse : nous reviendrons vers vous.
            </p>

            <div class="card shadow-sm">
                <div class="card-body">
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom) }}
                            <div class="text-danger small">{{ form_errors(form.nom) }}</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.email) }}
                            {{ form_widget(form.email) }}
                            <div class="text-danger small">{{ form_errors(form.email) }}</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.typesProduits) }}
                            {{ form_widget(form.typesProduits) }}
                            {{ form_help(form.typesProduits) }}
                            <div class="text-danger small">{{ form_errors(form.typesProduits) }}</div>
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.motivation) }}
                            {{ form_widget(form.motivation) }}
                            <div class="text-danger small">{{ form_errors(form.motivation) }}</div>
                        </div>
                        {{ form_widget(form.envoyer) }}
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
<!DOCTYPE html>
<html lang="fr">
<body style="margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;color:#212529;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:24px 0;">
        <tr>
            <td align="center">
                <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;">
                    <tr>
                        <td style="background:#212529;color:#ffffff;padding:20px 24px;font-size:22px;font-weight:bold;">
                            InnovShop
                        </td>
                    </tr>
                    <tr>
                        <td style="padding:24px;">
                            <p>Bonjour {{ commande.utilisateur.prenom }},</p>
                            <p>
                                Merci pour votre commande <strong>n° {{ commande.id }}</strong>
                                passée le {{ commande.dateCreation|date('d/m/Y à H:i') }}.
                                Elle est actuellement <strong>en attente de validation</strong>.
                            </p>

                            <table width="100%" cellpadding="8" cellspacing="0" style="border-collapse:collapse;margin:16px 0;">
                                <thead>
                                    <tr style="background:#f1f3f5;text-align:left;">
                                        <th>Produit</th>
                                        <th style="text-align:center;">Qté</th>
                                        <th style="text-align:right;">Prix</th>
                                        <th style="text-align:right;">Sous-total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for ligne in commande.ligneCommandes %}
                                        <tr style="border-bottom:1px solid #dee2e6;">
                                            <td>{{ ligne.nomProduit }}</td>
                                            <td style="text-align:center;">{{ ligne.quantite }}</td>
                                            <td style="text-align:right;">{{ ligne.prixUnitaire|number_format(2, ',', ' ') }} €</td>
                                            <td style="text-align:right;">{{ ligne.sousTotal|number_format(2, ',', ' ') }} €</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="3" style="text-align:right;font-weight:bold;padding-top:12px;">Total</td>
                                        <td style="text-align:right;font-weight:bold;padding-top:12px;">{{ commande.total|number_format(2, ',', ' ') }} €</td>
                                    </tr>
                                </tfoot>
                            </table>

                            <p style="margin-bottom:4px;"><strong>Adresse de livraison</strong></p>
                            <p style="margin-top:0;">{{ commande.adresseLivraison|nl2br }}</p>

                            <p>
                                <a href="{{ url('app_produit_index') }}"
                                   style="display:inline-block;background:#212529;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:4px;">
                                    Retourner sur la boutique
                                </a>
                            </p>
                        </td>
                    </tr>
                    <tr>
                        <td style="background:#f1f3f5;color:#6c757d;font-size:12px;padding:16px 24px;">
                            Cet email a été envoyé automatiquement, merci de ne pas y répondre.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>